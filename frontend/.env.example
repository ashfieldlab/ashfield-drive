# =============================================================================
# Frontend .env (Next.js)
#
# 사용: cp .env.example .env
# 인증 = Ashfield 계정 서버(OIDC) 로그인. 이 앱의 Better Auth 는 그 클라이언트일 뿐 (ADR-0024).
# 접속: http://localhost:3200   (계정 서버 http://localhost:3300 을 먼저 띄울 것, docs/local-dev.md)
# =============================================================================

# -----------------------------------------------------------------------------
# Better Auth (앱 세션)
# -----------------------------------------------------------------------------

# 세션 쿠키 암호화용 비밀값 (32자 이상 무작위). 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 이 앱의 공개 주소 (브라우저가 접속하는 origin).
#   - 계정 서버 로그인 콜백: ${BETTER_AUTH_URL}/api/auth/callback/ashfield (계정 서버에 등록된 값과 정확히 일치)
#   - 계정 서버에 요청하는 resource = 액세스 토큰 aud → 백엔드 .env 의 AUTH_AUDIENCE 와 같은 값
BETTER_AUTH_URL=http://localhost:3200

# Better Auth 테이블(세션과 계정 토큰)이 있는 Postgres: 백엔드와 같은 DB, 스키마 `auth` (make auth-migrate).
DATABASE_URL=postgresql://ashfield:ashfield_dev@localhost:15532/ashfield_drive

# -----------------------------------------------------------------------------
# Ashfield 계정 서버 (OIDC 제공자): 계약: ashfield-account docs/adr/0001
# -----------------------------------------------------------------------------

# 계정 서버 주소 = issuer. 디스커버리 ${ACCOUNT_URL}/.well-known/openid-configuration.
ACCOUNT_URL=http://localhost:3300
# 계정 서버에 등록된 client_id (기본 ashfield-drive).
ASHFIELD_CLIENT_ID=ashfield-drive
# client_secret: 계정 서버에서 `make seed` 가 출력하고 ashfield-account/.secrets/clients.local.json
# 의 "ashfield-drive".client_secret 에도 저장된다. 재발급: 계정 서버 `make seed-rotate`.
ASHFIELD_CLIENT_SECRET=

NODE_ENV=development

# 클라이언트 API base URL: 빈 값(권장): same-origin BFF(/api/v1/*). BFF 가 쿠키를 자격 증명으로 바꾼다.
# 절대 URL 박으면 백엔드 직접 호출(CORS 필요).
NEXT_PUBLIC_API_URL=

# 서버 사이드 (BFF가 백엔드 호출): 컨테이너면 http://backend:8000 등으로 변경. 로컬 기본 8200.
BACKEND_INTERNAL_URL=http://localhost:8200

# 클라이언트 API 호출 타임아웃 (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# 카테고리별 debug 로그 출력 제어 (auth | api | biz | ui)
NEXT_PUBLIC_LOG_CATEGORIES=

# 앱 표시 이름
NEXT_PUBLIC_APP_NAME=Ashfield

# 헤더의 일정 앱(ashfield-calendar) 링크. 빈 값이면 숨김.
# dev: Calendar 기본 포트 3100 / 운영 예: https://calendar.example.com
NEXT_PUBLIC_CALENDAR_URL=http://localhost:3100

# dev 한정: Next rewrites `/_minio/*` 가 프록시할 MinIO 주소 (next.config.ts, 기본 http://localhost:19200).
MINIO_PROXY_TARGET=http://localhost:19200


# =============================================================================
# Cookie 격리 / 공유
# =============================================================================

# 같은 localhost 의 여러 앱(drive/calendar 등)이 자체 cookie 를 섞지 않도록 이름에 prefix.
# (dev 한정: 운영은 도메인 분리.)
NEXT_PUBLIC_COOKIE_NS=ashfield-drive

# Cross-service 활성 워크스페이스용 cookie 도메인 (운영 한정, 예: .example.com).
# dev/단일도메인이면 비워둠(host-only).
NEXT_PUBLIC_COOKIE_DOMAIN=

# 개발용 UI 플레이그라운드(/playground). 개발 모드는 항상 켜져 있고, 운영에서 보려면 true.
NEXT_PUBLIC_PLAYGROUND=
