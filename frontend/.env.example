# =============================================================================
# Frontend .env (Next.js)
#
# 사용: cp .env.example .env
# 인증 = Better Auth (Google·GitHub 소셜 로그인). README "로그인 설정" 과 ADR-0023 참조.
# 접속: http://localhost:3000
# =============================================================================

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------

# 세션·키 암호화용 비밀값 (32자 이상 무작위). 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 이 앱의 공개 주소 (브라우저가 접속하는 origin). OAuth 콜백·JWT iss/aud 의 기준.
#   콜백 URL: ${BETTER_AUTH_URL}/api/auth/callback/google , ${BETTER_AUTH_URL}/api/auth/callback/github
#   백엔드 .env 의 AUTH_ISSUER·AUTH_AUDIENCE 도 이 값, AUTH_JWKS_URL 은 ${BETTER_AUTH_URL}/api/auth/jwks
BETTER_AUTH_URL=http://localhost:3000

# Better Auth 테이블이 있는 Postgres — 백엔드와 같은 DB, 스키마 `auth` (make auth-migrate 로 생성).
DATABASE_URL=postgresql://ashfield:ashfield_dev@localhost:15532/ashfield_drive

# 소셜 로그인 — ID/SECRET 이 둘 다 있는 제공자만 로그인 버튼이 보인다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 허용 이메일 (쉼표 구분, 대소문자 무시). 목록 밖 이메일은 가입·로그인을 서버에서 거부.
# ⚠️ 비워 두면 누구나 가입할 수 있다 (각자 개인 워크스페이스가 생김). 백엔드 .env 와 같은 값.
ALLOWED_EMAILS=

# 로컬·E2E 전용 이메일+비밀번호 로그인 (/login 에 DEV 폼). 기본 off.
# NODE_ENV=production 에서는 true 여도 무시된다. 운영에 절대 켜지 말 것.
AUTH_DEV_PASSWORD_LOGIN=false

NODE_ENV=development

# 클라이언트 API base URL — 빈 값(권장): same-origin BFF(/api/v1/*). BFF 가 쿠키를 자격 증명으로 바꾼다.
# 절대 URL 박으면 백엔드 직접 호출(CORS 필요).
NEXT_PUBLIC_API_URL=

# 서버 사이드 (BFF가 백엔드 호출) — 컨테이너면 http://backend:8000 등으로 변경.
BACKEND_INTERNAL_URL=http://localhost:8000

# 클라이언트 API 호출 타임아웃 (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# 카테고리별 debug 로그 출력 제어 (auth | api | biz | ui)
NEXT_PUBLIC_LOG_CATEGORIES=

# 앱 표시 이름
NEXT_PUBLIC_APP_NAME=Ashfield

# 헤더의 일정 앱(ashfield-calendar) 링크. 빈 값이면 숨김.
# dev: 일정 앱을 다른 포트(예: FRONTEND_PORT=3001)로 띄운 주소 / 운영 예: https://calendar.example.com
NEXT_PUBLIC_CALENDAR_URL=


# =============================================================================
# Cookie 격리 / 공유
# =============================================================================

# 같은 localhost 의 여러 앱(drive/calendar 등)이 자체 cookie 를 섞지 않도록 이름에 prefix.
# (dev 한정 — 운영은 도메인 분리.)
NEXT_PUBLIC_COOKIE_NS=ashfield-drive

# Cross-service 활성 회사 공유용 cookie 도메인 (운영 한정, 예: .example.com).
# dev/단일도메인이면 비워둠(host-only).
NEXT_PUBLIC_COOKIE_DOMAIN=
