# =============================================================================
# 운영 배포 환경변수 — .env.prod 로 복사 후 채움.
#
# 시작:
#   cp .env.prod.example .env.prod
#   # BETTER_AUTH_SECRET·SMTP_ENCRYPTION_KEY·DB 비번 등 생성·교체
#   make prod-up
# =============================================================================

# 프로젝트 네임스페이스 (compose container 이름 prefix)
COMPOSE_PROJECT_NAME=ashfield-drive-prod

# ───── 포트 노출 (모두 127.0.0.1 only — 호스트 reverse proxy 가 접근)
# 일정 앱(82xx)과 같은 서버에 함께 띄우므로 81xx 대역.
BACKEND_HOST_PORT=8101
FRONTEND_HOST_PORT=3101
MINIO_HOST_PORT=9101
MINIO_CONSOLE_HOST_PORT=9102

# ───── Postgres
POSTGRES_USER=ashfield
POSTGRES_PASSWORD=__CHANGE_ME__strong_random__
POSTGRES_DB=ashfield_drive

# ───── S3
# - 내부 (backend → minio) : http://minio:9000
# - 외부 (브라우저용 presigned URL host) : reverse proxy 가 minio 로 forward 하는 URL
#     파일은 files 앱에서 열리므로 files 도메인의 /_minio
#     외부 S3 호환 스토리지 : 해당 서비스의 엔드포인트 URL
S3_ENDPOINT_URL=http://minio:9000
# reverse proxy 는 /_minio 를 127.0.0.1:MINIO_HOST_PORT 로 넘기며 Host 를 minio:9000 으로 둔다 (presigned 서명 host).
S3_PUBLIC_ENDPOINT_URL=https://drive.example.com/_minio
S3_BUCKET=workspace
S3_ACCESS_KEY=__CHANGE_ME__
S3_SECRET_KEY=__CHANGE_ME__strong_random__
S3_REGION=us-east-1

# ───── SMTP (이메일 발송 — 즉시 끄려면 SMTP_ENABLED=false)
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Ashfield
# Fernet 32 bytes base64 — `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
SMTP_ENCRYPTION_KEY=__CHANGE_ME__generate__

# ───── 인증 (Ashfield 계정 서버 SSO, ADR-0024 · docs/local-dev.md)
# 32자 이상 무작위: openssl rand -base64 32
BETTER_AUTH_SECRET=__CHANGE_ME__generate__
# 이 앱의 공개 주소. 계정 서버 로그인 콜백: ${BETTER_AUTH_URL}/api/auth/callback/ashfield
# = 계정 서버의 DRIVE_URL (액세스 토큰 aud, 백엔드 AUTH_AUDIENCE).
BETTER_AUTH_URL=https://drive.example.com
# 계정 서버 주소 (issuer). 백엔드 AUTH_JWKS_URL·AUTH_ISSUER 도 여기서 만든다.
ACCOUNT_URL=https://account.example.com
# 계정 서버에 등록된 client (계정 서버 `make seed` 출력 / .secrets/clients.local.json).
ASHFIELD_CLIENT_ID=ashfield-drive
ASHFIELD_CLIENT_SECRET=__CHANGE_ME__from_account_seed__
# System Admin 이메일 (쉼표 구분, 선택).
SYSTEM_ADMIN_EMAILS=

# ───── 프론트
# /api 는 same-origin 으로 호출. 반드시 비움.
NEXT_PUBLIC_API_URL=
# 헤더의 일정 앱(ashfield-calendar) 링크. 비우면 숨김.
NEXT_PUBLIC_CALENDAR_URL=https://calendar.example.com
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_APP_NAME=Ashfield
# 다중 다운스트림 같은 도메인 사용 시만 채움. 단일 호스트면 비움.
NEXT_PUBLIC_COOKIE_NS=ashfield-drive
NEXT_PUBLIC_COOKIE_DOMAIN=

# ───── 백엔드 이메일 링크 base URL
FILES_BASE_URL=https://drive.example.com

# ───── 보관 정책
TRASH_RETENTION_DAYS=30

# ───── 로깅 카테고리 (debug 출력 제어) — 운영은 비움 (info 만)
LOG_CATEGORIES=
