# =============================================================================
# Ashfield Drive: 운영 환경 변수 (docs/deploy.md)
#
# 서버에서 `scripts/prod.sh init-env` (로컬: make deploy-init) 가 이 파일을 .env.prod 로 복사하고
# __GENERATE__ 는 openssl 로, __FROM_ACCOUNT__ 는 계정 서버의 .secrets/clients.local.json 에서 채운다.
# .env.prod 는 서버에만 둔다 (gitignore).
# =============================================================================

COMPOSE_PROJECT_NAME=ashfield-drive-prod

# ───── 포트 (LAN 바인딩: 앞단 리버스 프록시가 받는다). backend 는 열지 않는다.
FRONTEND_HOST_PORT=3200
MINIO_HOST_PORT=3201
# MinIO 콘솔은 127.0.0.1 에만: ssh -L 3202:127.0.0.1:3202 ovm
MINIO_CONSOLE_HOST_PORT=3202

# ───── 주소
# 이 앱의 공개 주소. 계정 서버 로그인 콜백 ${BETTER_AUTH_URL}/api/auth/callback/ashfield,
# 토큰 aud(백엔드 AUTH_AUDIENCE), 이메일 링크의 기준. = 계정 서버의 DRIVE_URL
BETTER_AUTH_URL=https://drive.ashfieldlab.dev
# 계정 서버 주소 (issuer). 백엔드 AUTH_JWKS_URL, AUTH_ISSUER 도 여기서 만든다.
ACCOUNT_URL=https://account.ashfieldlab.dev
# 브라우저가 presigned URL 로 파일을 올리고 받는 주소. 앞단 프록시가 /_minio/* 를 MinIO 로 넘기며
# Host 를 minio:9000 으로 바꾼다 (presigned 서명 host).
S3_PUBLIC_ENDPOINT_URL=https://drive.ashfieldlab.dev/_minio
# 헤더의 일정 앱 링크 (빌드 때 굳는다). 비우면 숨김.
NEXT_PUBLIC_CALENDAR_URL=https://calendar.ashfieldlab.dev

# ───── 비밀값
POSTGRES_USER=ashfield
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=ashfield_drive
# MinIO 루트 계정 = 백엔드 S3 키
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_BUCKET=workspace
S3_REGION=us-east-1
# 앱 세션 쿠키 암호화
BETTER_AUTH_SECRET=__GENERATE__
# DB 에 저장하는 SMTP 비밀번호 암호화 키 (Fernet)
SMTP_ENCRYPTION_KEY=__GENERATE__
# 계정 서버에 등록된 client (계정 서버 배포가 .secrets/clients.local.json 에 저장)
ASHFIELD_CLIENT_ID=ashfield-drive
ASHFIELD_CLIENT_SECRET=__FROM_ACCOUNT__

# System Admin 이메일 (쉼표 구분). init-env 에 ADMIN_EMAIL 을 주면 비어 있을 때 채운다.
SYSTEM_ADMIN_EMAILS=

# ───── SMTP: 끄면 메일은 보내지 않고 로그만 남긴다
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=
SMTP_FROM_NAME=Ashfield

# ───── 업로드: 이 크기 이상은 multipart. 요청 하나의 최대 크기 = max(threshold 미만, part size).
# Cloudflare 프록시는 요청당 100MB 제한: 둘 다 그보다 작게 둘 것.
MULTIPART_THRESHOLD_BYTES=52428800
MULTIPART_PART_SIZE_BYTES=8388608
PRESIGN_DOWNLOAD_TTL_SECONDS=300
PRESIGN_PREVIEW_TTL_SECONDS=300

# ───── 기타
TRASH_RETENTION_DAYS=30
# 백엔드 debug 로그 카테고리: 운영은 비움
LOG_CATEGORIES=
