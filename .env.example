# =============================================================================
# Ashfield Drive — 루트 .env (docker-compose + backend)
#
# 사용: cp .env.example .env  후 채워서 사용.
# 프론트엔드용 변수는 frontend/.env.example 참조 (Next.js는 부모 .env를 안 읽음).
# =============================================================================


# =============================================================================
# 환경 구분
# =============================================================================
ENVIRONMENT=development


# =============================================================================
# Compose 프로젝트 격리 (포트·이름 충돌 회피)
#
# 새 프로젝트 시작 시 — 두 줄만 자기 값으로 변경:
#   1. COMPOSE_PROJECT_NAME: 프로젝트 이름
#   2. *_HOST_PORT: 호스트 포트 (같은 호스트의 다른 프로젝트와 충돌 회피)
# =============================================================================
COMPOSE_PROJECT_NAME=ashfield-drive

# 호스트 포트: Ashfield 앱끼리 겹치지 않게 (docs/local-dev.md "포트"). 19000 은 VS Code 가 쓴다.
POSTGRES_HOST_PORT=15532
REDIS_HOST_PORT=16479
MINIO_HOST_PORT=19200          # S3 API
MINIO_CONSOLE_HOST_PORT=19201  # MinIO 웹 콘솔
MAILPIT_SMTP_HOST_PORT=11025   # dev SMTP catcher
MAILPIT_WEB_HOST_PORT=18025    # mailpit 웹 UI

# Postgres 자격증명 (개발 전용 — 운영은 별도 secrets)
POSTGRES_USER=ashfield
POSTGRES_PASSWORD=ashfield_dev
POSTGRES_DB=ashfield_drive


# =============================================================================
# Backend (pydantic-settings)
# =============================================================================

DATABASE_URL=postgresql+asyncpg://ashfield:ashfield_dev@localhost:15532/ashfield_drive
REDIS_URL=redis://localhost:16479

# -----------------------------------------------------------------------------
# 인증: Ashfield 계정 서버(OIDC)가 발급한 액세스 토큰(JWT) 검증 (ADR-0024)
#
# 계정 서버(ashfield-account, 기본 http://localhost:3300)가 issuer. 셋 다 필수 (비면 인증 요청이 503,
# ENVIRONMENT=production 이면 부팅 거부).
#   AUTH_AUDIENCE = 이 앱의 공개 주소 = frontend/.env 의 BETTER_AUTH_URL (= 계정 서버 DRIVE_URL)
# 가입 허용(허용 이메일)·로그인 수단은 계정 서버 설정이다.
# -----------------------------------------------------------------------------
AUTH_JWKS_URL=http://localhost:3300/api/auth/jwks
AUTH_ISSUER=http://localhost:3300
AUTH_AUDIENCE=http://localhost:3200

# System Admin 이메일 (쉼표 구분). users.is_system_admin 컬럼과 OR.
SYSTEM_ADMIN_EMAILS=


# =============================================================================
# S3-compatible Storage (ADR-0005)
# =============================================================================

# 개발: docker-compose의 MinIO. 운영: S3-compatible storage.
S3_ENDPOINT_URL=http://localhost:19200
# Presigned URL 클라이언트 노출용 host — dev 한정 Chrome PNA 우회 (Next.js rewrites /_minio/*).
# 비워두면 FRONTEND_PORT 기반 자동 derive (localhost:{FRONTEND_PORT}/_minio).
# 운영(컨테이너·k8s)에서는 진짜 S3 도메인을 명시.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=workspace-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_secret
S3_REGION=us-east-1               # MinIO는 임의값. 외부 S3 는 해당 리전.

# Presigned URL 만료 (초). 짧게 — 발급 즉시 사용 가정.
PRESIGN_UPLOAD_TTL_SECONDS=60
PRESIGN_DOWNLOAD_TTL_SECONDS=30


# =============================================================================
# SMTP (이메일 알림)
# =============================================================================

# dev: docker-compose 의 mailpit (실제 발송 X — http://localhost:18025 web UI 로 확인).
# 운영: SES/Mailgun/Gmail 등 실제 SMTP.
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=noreply@ashfield.local
SMTP_FROM_NAME=Ashfield
# 이메일 링크 base URL. dev 는 기본값(localhost) 이면 충분, 운영은 https://drive.example.com.
FILES_BASE_URL=http://localhost:3200

# DB 에 저장되는 SMTP 비밀번호 암호화 키 (Fernet 32 bytes base64).
# 발급: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# 운영은 secret manager. 분실 시 SMTP 재설정만 하면 됨.
SMTP_ENCRYPTION_KEY=


# =============================================================================
# 보관 기간
# =============================================================================

# 휴지통 자동 비우기 — N일 지난 soft-deleted 노드 hard delete + S3 정리.
TRASH_RETENTION_DAYS=30


# =============================================================================
# 로깅 (백엔드)
# =============================================================================

LOG_CATEGORIES=

# dev 서버 포트 (make frontend / make backend / make e2e). Account 3300, Calendar 3100/8100 과 겹치지 않게.
# 백엔드도 FRONTEND_PORT 로 presigned URL 의 same-origin 주소(localhost:{FRONTEND_PORT}/_minio)를 만든다.
FRONTEND_PORT=3200
BACKEND_PORT=8200
